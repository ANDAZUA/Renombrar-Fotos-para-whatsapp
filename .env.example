# Never commit the real values from this file.
APP_USERNAME=equipo
# Generate with: PYTHONPATH=src python3 -m whatsapp_photo_renamer.webapp --hash-password
APP_PASSWORD_HASH=
# Generate a long random value for deployed environments.
SESSION_SECRET=replace-with-a-long-random-secret
# Set to 1 only when the app is behind HTTPS. Keep 0 for local http://127.0.0.1.
COOKIE_SECURE=0
# Upload and archive limits are fixed in the MVP: 50 MB upload, 250 MB expanded ZIP.
